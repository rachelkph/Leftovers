# Read by the dev server's /api/scan route (never shipped to the browser).
# Leave empty to scan through Claude Code on your Claude subscription instead.
ANTHROPIC_API_KEY=

# Optional: force a scanner — api | claude-code
LEFTOVERS_SCANNER=

# Optional: cloud sync across your devices (Supabase). Both values are public by design —
# row-level security keeps your data private. Leave empty to keep everything on this device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hosted only (set in Vercel, not needed locally): extra lock on scanning, comma-separated.
# ALLOWED_EMAILS=you@example.com
